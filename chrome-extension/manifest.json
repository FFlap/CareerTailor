{
  "manifest_version": 3,
  "name": "CareerTailor",
  "version": "0.1.0",
  "description": "Capture job details and generate resumes/cover letters in the CareerTailor web app.",
  "action": {
    "default_title": "CareerTailor",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "tabs"],
  "host_permissions": [
    "https://*.indeed.com/*",
    "https://*.linkedin.com/*",
    "https://*.glassdoor.com/*",
    "https://bold-cheetah-58.convex.cloud/*",
    "http://localhost:*/*",
    "http://127.0.0.1:*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.indeed.com/*",
        "https://*.linkedin.com/*",
        "https://*.glassdoor.com/*"
      ],
      "js": ["content_scripts/job_scraper.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "pages/auth-callback.html",
        "pages/auth-callback.js",
        "pages/blocked.html",
        "pages/blocked.js",
        "pages/blocked.css"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://bold-cheetah-58.convex.cloud http://localhost:* http://127.0.0.1:*;"
  }
}
